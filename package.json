{
  "name": "yuvraj-portfolio",
  "version": "2026.09.9",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./Assets/css/input.css -o ./Assets/css/main.css --minify",
    "watch:css": "tailwindcss -i ./Assets/css/input.css -o ./Assets/css/main.css --watch",
    "dev": "npx --yes serve . -p 8080",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:og": "node scripts/generate-og-banner.mjs",
    "generate:previews": "node scripts/generate-project-previews.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test": "npm run verify:assets && npm run test:contact-api && npm run test:visitors-api && npm run test:book-call-api && npm run test:stats-api && npm run test:e2e && npm run test:magnifier && npm run test:nav-magnifier && npm run test:cv",
    "test:stats-api": "node scripts/test-stats-api.mjs",
    "test:contact-api": "node scripts/test-contact-api.mjs",
    "test:visitors-api": "node scripts/test-visitors-api.mjs",
    "test:book-call-api": "node scripts/test-book-call-api.mjs",
    "smoke:book-call-mail": "node scripts/smoke-book-call-mail.mjs",
    "deploy:env": "node scripts/sync-vercel-env.mjs",
    "sync:vercel-env": "node scripts/sync-vercel-env.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:magnifier": "node scripts/test-magnifier.mjs",
    "test:nav-magnifier": "node scripts/test-nav-magnifier.mjs",
    "test:cv": "node scripts/test-cv-preview.mjs",
    "predeploy": "npm run build:css && npm run verify:assets"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.9",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.52.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17"
  }
}
