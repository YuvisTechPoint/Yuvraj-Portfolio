# Vercel / local serverless — copy to .env.local for local API testing (never commit .env)
# Set these in Vercel Project Settings → Environment Variables for production contact delivery.
#
# Option A (recommended for Book a Call dual mail + attachments): Gmail App Password
# Creates mail to the guest AND to prasadyuvraj8805@gmail.com with .txt report + .ics invite.
# Google Account → Security → App passwords
GMAIL_USER=prasadyuvraj8805@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
#
# Option B: Resend — https://resend.com
# Guest inbox delivery needs a verified sending domain in CONTACT_FROM (not only onboarding@resend.dev).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM=Yuvraj Prasad <prasadyuvraj8805@gmail.com>
#
# Book a Call (production — never set BOOKING_ALLOW_TEST_SEND on Vercel)
BOOKING_SITE_URL=https://yuvrajprasad.vercel.app
BOOKING_UPI_ID=prasadyuvraj8805-5@okicici
BOOKING_HOST_EMAIL=prasadyuvraj8805@gmail.com
#
# Option C: Web3Forms — https://web3forms.com (verify prasadyuvraj8805@gmail.com, copy access key)
# Used by the browser when the server relay is unavailable (works from file:// too).
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Optional — raises GitHub API rate limits for /api/github live stats
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Visitor counter (footer) — Vercel KV or Upstash Redis (free tier)
# Vercel: Storage → KV → Connect → auto-injects KV_REST_API_URL + KV_REST_API_TOKEN
# Upstash: https://upstash.com → create Redis → copy REST URL + token
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
# Optional offset for traffic before the counter was enabled
# VISITOR_BASELINE=0
